# Сгенерируйте локальные значения: python scripts/init_local_env.py
HF_ENVIRONMENT=development
HF_COOKIE_SECURE=false
HF_ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:8000"]'
HF_DB_PASSWORD=replace-with-random-value
HF_DATABASE_URL=postgresql+psycopg://honeyforge:replace-with-random-value@127.0.0.1:55432/honeyforge
HF_TEST_DATABASE_URL=postgresql+psycopg://honeyforge:replace-with-random-value@127.0.0.1:55432/honeyforge_test
HF_SESSION_SECRET=replace-with-at-least-32-random-characters
HF_CREDENTIAL_KEY=replace-with-fernet-key
