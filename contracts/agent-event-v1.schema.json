{
  "$defs": {
    "JsonValue": {},
    "Service": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "tcp",
            "http",
            "ssh"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "protocol",
        "port"
      ],
      "title": "Service",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "format": "ipvanyaddress",
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "agent_id": {
      "format": "uuid",
      "title": "Agent Id",
      "type": "string"
    },
    "deployment_id": {
      "format": "uuid",
      "title": "Deployment Id",
      "type": "string"
    },
    "instance_id": {
      "format": "uuid",
      "title": "Instance Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "source_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Source Seq",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "type": {
      "enum": [
        "connection.opened",
        "auth.attempt",
        "session.command",
        "session.output",
        "http.request",
        "artifact.observed",
        "token.triggered",
        "session.closed",
        "runtime.state"
      ],
      "title": "Type",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "service": {
      "$ref": "#/$defs/Service"
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "profile_revision": {
      "minimum": 1,
      "title": "Profile Revision",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "agent_id",
    "deployment_id",
    "instance_id",
    "source_seq",
    "occurred_at",
    "type",
    "source",
    "service",
    "data",
    "artifact_ids",
    "profile_revision"
  ],
  "title": "Event",
  "type": "object"
}
