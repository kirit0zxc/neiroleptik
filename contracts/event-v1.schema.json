{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:honeyforge:event:v1",
  "title": "HoneyForgeEventV1",
  "description": "Нормализованное событие для UI. received_at назначает центр; это не схема входного пакета агента.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "type": {
      "type": "string",
      "enum": [
        "connection.opened",
        "auth.attempt",
        "session.command",
        "session.output",
        "http.request",
        "tcp.request",
        "artifact.observed",
        "token.triggered",
        "session.closed",
        "runtime.state"
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ip": {
              "type": "string",
              "description": "IPv4 или IPv6 исходного клиента"
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "ip",
            "port"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "http",
            "ssh"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "protocol",
        "port"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Поля зависят от type; весь текст недоверенный. Пароли в общей ленте маскируются."
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "agent_id",
    "deployment_id",
    "instance_id",
    "session_id",
    "source_seq",
    "occurred_at",
    "received_at",
    "type",
    "source",
    "service",
    "data",
    "artifact_ids",
    "profile_revision"
  ]
}
