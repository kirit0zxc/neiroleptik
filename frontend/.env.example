# 1 — работать на моках MSW без backend
VITE_API_MOCK=1
# Адрес backend для прокси dev-сервера
VITE_API_PROXY=http://127.0.0.1:8000

# Телеметрия сервера включается по мере готовности backend.
# Общий выключатель — включает все три возможности сразу:
VITE_TELEMETRY_ENABLED=0
# Либо включайте по отдельности:
# 1 — лента событий и живой WebSocket-поток готовы на сервере
VITE_EVENTS_ENABLED=0
# 1 — сводка обзора /analytics/summary готова на сервере
VITE_ANALYTICS_ENABLED=0
# 1 — запись сессии (replay) готова на сервере
VITE_REPLAY_ENABLED=0
# 1 — расследование: алерты, медовые токены, артефакты, экспорт IoC (есть на сервере с PR #35)
VITE_INVESTIGATION_ENABLED=1
