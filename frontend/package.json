{
  "name": "mascot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./vrm": {
      "types": "./dist-lib/types/vrm.d.ts",
      "import": "./dist-lib/vrm.js"
    },
    "./react": {
      "types": "./dist-lib/types/react.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./standalone": "./dist-standalone/mascot.global.js"
  },
  "files": [
    "dist-lib",
    "dist-standalone"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs dist-lib",
    "build:standalone": "vite build --config vite.standalone.config.ts && node scripts/copy-assets.mjs dist-standalone",
    "build:all": "npm run build && npm run build:lib && npm run build:standalone",
    "optimize": "node scripts/optimize-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:ci": "vitest run"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "react": ">=18",
    "three": ">=0.170",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
